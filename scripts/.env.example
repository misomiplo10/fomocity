# Copy to scripts/.env (gitignored) and fill in.
# Helius mainnet RPC + websockets for launch, keeper and tracker.
HELIUS_API_KEY=
# Or any RPC instead of Helius (RPC_URL wins if both are set):
# RPC_URL=

# Game mint printed by `npm run launch` (used by keeper and tracker).
MINT=
# Keeper keypair file.
KEEPER=~/.config/solana/fomocity-keeper.json
